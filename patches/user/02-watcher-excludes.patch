 				'*/.git/subtree-cache/**': true,
-				'*/.hg/store/**': true
+				'*/.hg/store/**': true,
+				// lean-code: heavy generated/dependency folders (root and one level deep; node_modules also two levels deep,
+				// see the note above about avoiding a leading '**' pattern)
+				'node_modules/**': true,
+				'*/node_modules/**': true,
+				'*/*/node_modules/**': true,
+				'dist/**': true,
+				'*/dist/**': true,
+				'build/**': true,
+				'*/build/**': true,
+				'target/**': true,
+				'*/target/**': true,
+				'.venv/**': true,
