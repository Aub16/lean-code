+// lean-code: progressive, habit-aware folder search for the remote (SSH) folder picker.
+
+import * as nls from '../../../../nls.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { URI } from '../../../../base/common/uri.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+
+export const LEAN_FOLDER_SEARCH_SETTING = 'lean.remote.optimizeFolderSearch';
+export type LeanFolderSearchSetting = 'ask' | 'always' | 'never';
+
+Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerConfiguration({
+	id: 'leanRemote',
+	title: nls.localize('leanRemote.title', "Lean Remote"),
+	type: 'object',
+	properties: {
+		[LEAN_FOLDER_SEARCH_SETTING]: {
+			type: 'string',
+			enum: ['ask', 'always', 'never'],
+			enumDescriptions: [
+				nls.localize('leanRemote.optimize.ask', "Ask once per SSH host when connecting."),
+				nls.localize('leanRemote.optimize.always', "Always optimize the remote folder search."),
+				nls.localize('leanRemote.optimize.never', "Never optimize the remote folder search.")
+			],
+			default: 'ask',
+			description: nls.localize('leanRemote.optimize', "Optimize the remote folder picker: results are searched progressively below the current folder, ranked by proximity and by the folders you open most often on this host.")
+		}
+	}
+});
+
+const modeKey = (authority: string) => `lean.remote.folderSearch.mode.${authority}`;
+const historyKey = (authority: string) => `lean.remote.folderSearch.history.${authority}`;
+
+export function getLeanFolderSearchChoice(storageService: IStorageService, authority: string): 'on' | 'off' | undefined {
+	const value = storageService.get(modeKey(authority), StorageScope.APPLICATION);
+	return value === 'on' || value === 'off' ? value : undefined;
+}
+
+export function setLeanFolderSearchChoice(storageService: IStorageService, authority: string, enabled: boolean): void {
+	storageService.store(modeKey(authority), enabled ? 'on' : 'off', StorageScope.APPLICATION, StorageTarget.MACHINE);
+}
+
+export function isLeanFolderSearchEnabled(configurationService: IConfigurationService, storageService: IStorageService, authority: string | undefined): boolean {
+	if (!authority) {
+		return false;
+	}
+	const setting = configurationService.getValue<LeanFolderSearchSetting>(LEAN_FOLDER_SEARCH_SETTING);
+	if (setting === 'always') {
+		return true;
+	}
+	if (setting === 'never') {
+		return false;
+	}
+	return getLeanFolderSearchChoice(storageService, authority) === 'on';
+}
+
+interface IHistoryEntry {
+	/** visit count */
+	c: number;
+	/** last visit (epoch ms) */
+	t: number;
+}
+
+function trimSlash(path: string): string {
+	return path.length > 1 && path.endsWith('/') ? path.substring(0, path.length - 1) : path;
+}
+
+/**
+ * Per-host history of folders the user actually opened. Used to rank search results and suggestions.
+ */
+export class LeanFolderHistory {
+
+	private static readonly MAX_ENTRIES = 200;
+	private static readonly HALF_LIFE_DAYS = 14;
+
+	constructor(
+		private readonly storageService: IStorageService,
+		private readonly authority: string
+	) { }
+
+	private load(): Record<string, IHistoryEntry> {
+		try {
+			const raw = this.storageService.get(historyKey(this.authority), StorageScope.APPLICATION);
+			const parsed = raw ? JSON.parse(raw) : {};
+			return parsed && typeof parsed === 'object' ? parsed : {};
+		} catch {
+			return {};
+		}
+	}
+
+	private static weight(entry: IHistoryEntry, now: number): number {
+		const ageDays = Math.max(0, (now - entry.t) / 86_400_000);
+		return entry.c * Math.pow(0.5, ageDays / LeanFolderHistory.HALF_LIFE_DAYS);
+	}
+
+	record(folder: URI): void {
+		const path = trimSlash(folder.path);
+		const now = Date.now();
+		const entries = this.load();
+		const previous = entries[path];
+		entries[path] = { c: (previous?.c ?? 0) + 1, t: now };
+
+		const keys = Object.keys(entries);
+		if (keys.length > LeanFolderHistory.MAX_ENTRIES) {
+			keys.sort((a, b) => LeanFolderHistory.weight(entries[b], now) - LeanFolderHistory.weight(entries[a], now));
+			for (const key of keys.slice(LeanFolderHistory.MAX_ENTRIES)) {
+				delete entries[key];
+			}
+		}
+		this.storageService.store(historyKey(this.authority), JSON.stringify(entries), StorageScope.APPLICATION, StorageTarget.MACHINE);
+	}
+
+	/** Most useful visited folder paths first. */
+	top(count: number): string[] {
+		const now = Date.now();
+		const entries = this.load();
+		return Object.keys(entries)
+			.sort((a, b) => LeanFolderHistory.weight(entries[b], now) - LeanFolderHistory.weight(entries[a], now))
+			.slice(0, count);
+	}
+
+	/**
+	 * Habit score of a candidate folder: full weight when it was opened itself,
+	 * half when it contains a folder that was opened, a quarter when it lies below one.
+	 */
+	score(candidatePath: string): number {
+		const candidate = trimSlash(candidatePath);
+		const now = Date.now();
+		const entries = this.load();
+		let best = 0;
+		for (const path of Object.keys(entries)) {
+			const weight = LeanFolderHistory.weight(entries[path], now);
+			if (path === candidate) {
+				best = Math.max(best, weight);
+			} else if (path.startsWith(candidate + '/')) {
+				best = Math.max(best, weight * 0.5);
+			} else if (candidate.startsWith(path + '/')) {
+				best = Math.max(best, weight * 0.25);
+			}
+		}
+		return best;
+	}
+}
+
+export interface ILeanFolderHit {
+	readonly uri: URI;
+	/** Path relative to the folder the search started from. */
+	readonly relative: string;
+	readonly score: number;
+}
+
+export interface ILeanFolderSearchLimits {
+	readonly maxDepth: number;
+	readonly maxDirs: number;
+	readonly maxResults: number;
+	readonly maxMs: number;
+	readonly concurrency: number;
+}
+
+const DEFAULT_LIMITS: ILeanFolderSearchLimits = { maxDepth: 4, maxDirs: 400, maxResults: 30, maxMs: 8000, concurrency: 6 };
+
+const SKIPPED_DIRECTORIES = new Set([
+	'node_modules', '.git', 'dist', 'build', 'target', '.venv', 'venv', '__pycache__', '.next', 'vendor', 'coverage', '.cache', '.gradle', '.idea', '.vscode', '.lean-code-server', '.vscode-server', '.npm', '.cargo', '.rustup'
+]);
+
+const PROJECT_MARKERS = new Set(['.git', 'package.json', 'pom.xml', 'Cargo.toml', 'go.mod', 'pyproject.toml', 'composer.json', 'build.gradle', 'Makefile', 'docker-compose.yml', 'docker-compose.yaml']);
+
+function matchQuality(name: string, query: string): number {
+	const lowerName = name.toLowerCase();
+	if (lowerName === query) {
+		return 4;
+	}
+	if (lowerName.startsWith(query)) {
+		return 3;
+	}
+	if (new RegExp(`[-_. ]${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(lowerName)) {
+		return 2;
+	}
+	return lowerName.includes(query) ? 1 : 0;
+}
+
+/**
+ * Breadth-first search below `root`: closest folders first, in waves, so the picker can show results as they arrive.
+ * `onResults` receives the full, ranked result list after each wave that found something new.
+ */
+export async function leanSearchFolders(
+	fileService: IFileService,
+	root: URI,
+	rawQuery: string,
+	history: LeanFolderHistory,
+	token: CancellationToken,
+	onResults: (hits: ILeanFolderHit[]) => void,
+	limits: ILeanFolderSearchLimits = DEFAULT_LIMITS
+): Promise<void> {
+	const query = rawQuery.trim().toLowerCase();
+	if (!query) {
+		return;
+	}
+	const showHidden = query.startsWith('.');
+	const rootPath = trimSlash(root.path);
+	const started = Date.now();
+	const hits: ILeanFolderHit[] = [];
+	const queue: { uri: URI; depth: number }[] = [{ uri: root, depth: 0 }];
+	let visited = 0;
+
+	while (queue.length && visited < limits.maxDirs && !token.isCancellationRequested && Date.now() - started < limits.maxMs) {
+		const wave = queue.splice(0, limits.concurrency);
+		visited += wave.length;
+		let foundNew = false;
+
+		const resolved = await Promise.all(wave.map(async entry => {
+			try {
+				return { entry, stat: await fileService.resolve(entry.uri) };
+			} catch {
+				return { entry, stat: undefined };
+			}
+		}));
+		if (token.isCancellationRequested) {
+			return;
+		}
+
+		for (const { entry, stat } of resolved) {
+			const children = stat?.children ?? [];
+			const isProject = children.some(child => PROJECT_MARKERS.has(child.name));
+
+			// The folder we just listed is a candidate itself (the root is not).
+			if (entry.depth > 0) {
+				const name = entry.uri.path.split('/').filter(Boolean).pop() ?? '';
+				const quality = matchQuality(name, query);
+				if (quality > 0) {
+					const path = trimSlash(entry.uri.path);
+					const relative = path.startsWith(rootPath) ? path.substring(rootPath.length).replace(/^\//, '') : path;
+					const score = quality * 10 + history.score(path) * 5 + (isProject ? 3 : 0) - entry.depth * 2;
+					hits.push({ uri: entry.uri, relative, score });
+					foundNew = true;
+				}
+			}
+
+			if (entry.depth < limits.maxDepth) {
+				for (const child of children) {
+					if (!child.isDirectory || SKIPPED_DIRECTORIES.has(child.name) || (!showHidden && child.name.startsWith('.'))) {
+						continue;
+					}
+					queue.push({ uri: child.resource, depth: entry.depth + 1 });
+				}
+			}
+		}
+
+		if (foundNew) {
+			hits.sort((a, b) => b.score - a.score);
+			if (hits.length > limits.maxResults) {
+				hits.length = limits.maxResults;
+			}
+			onResults([...hits]);
+		}
+		if (hits.length >= limits.maxResults && hits[hits.length - 1].score > 20) {
+			return;
+		}
+	}
+}
