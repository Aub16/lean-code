+// lean-code: when connecting to a host over SSH, ask once whether to optimize the remote folder search.
+
+import * as nls from '../../../../nls.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import Severity from '../../../../base/common/severity.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { INotificationService } from '../../../../platform/notification/common/notification.js';
+import { IStorageService } from '../../../../platform/storage/common/storage.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IWorkbenchEnvironmentService } from '../../../services/environment/common/environmentService.js';
+import { getLeanFolderSearchChoice, LEAN_FOLDER_SEARCH_SETTING, LeanFolderSearchSetting, setLeanFolderSearchChoice } from '../../../services/dialogs/browser/leanFolderSearch.js';
+
+class LeanFolderSearchPrompt extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.leanFolderSearchPrompt';
+
+	constructor(
+		@IWorkbenchEnvironmentService environmentService: IWorkbenchEnvironmentService,
+		@IConfigurationService configurationService: IConfigurationService,
+		@IStorageService storageService: IStorageService,
+		@INotificationService notificationService: INotificationService
+	) {
+		super();
+
+		const authority = environmentService.remoteAuthority;
+		if (!authority || !authority.startsWith('ssh-remote+')) {
+			return;
+		}
+		if (configurationService.getValue<LeanFolderSearchSetting>(LEAN_FOLDER_SEARCH_SETTING) !== 'ask') {
+			return;
+		}
+		if (getLeanFolderSearchChoice(storageService, authority) !== undefined) {
+			return;
+		}
+
+		notificationService.prompt(
+			Severity.Info,
+			nls.localize('lean.folderSearch.prompt', "Optimize folder search on this SSH host? Folders below the current one are searched progressively and ranked by the folders you open most often."),
+			[
+				{ label: nls.localize('lean.folderSearch.enable', "Optimize"), run: () => setLeanFolderSearchChoice(storageService, authority, true) },
+				{ label: nls.localize('lean.folderSearch.disable', "No thanks"), run: () => setLeanFolderSearchChoice(storageService, authority, false) }
+			]
+		);
+	}
+}
+
+registerWorkbenchContribution2(LeanFolderSearchPrompt.ID, LeanFolderSearchPrompt, WorkbenchPhase.AfterRestored);
